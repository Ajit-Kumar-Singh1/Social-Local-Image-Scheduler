# Copy this file to .env in the project root, then replace the Meta placeholders.
POSTGRES_PASSWORD=sociallocal
WEB_PORT=5173

# Meta for Developers > your app > App settings > Basic
FACEBOOK_APP_ID=your_meta_app_id
FACEBOOK_APP_SECRET=your_meta_app_secret
# Optional frontend value used for Facebook developer/help links; use the same App ID.
VITE_FACEBOOK_APP_ID=your_meta_app_id

# Local Docker Desktop defaults. For real Facebook image publishing, see README-docker.md:
# Facebook's servers cannot fetch media at localhost; use a public HTTPS tunnel/domain.
APP_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5173

# Optional, used only by AI image generation.
HUGGING_FACE_API_KEY=